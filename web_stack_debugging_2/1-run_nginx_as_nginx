#!/usr/bin/env bash
# Configures Nginx to run as the nginx user listening on port 8080

# Fix port in configuration file
sed -i 's/listen 80/listen 8080/g' /etc/nginx/sites-available/default
sed -i 's/80/8080/g' /etc/nginx/sites-available/default

# Stop any running Nginx service
service nginx stop

# Run Nginx directly under the nginx user
sudo -u nginx nginx
